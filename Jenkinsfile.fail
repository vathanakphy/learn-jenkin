pipeline{
    agent any
    stages{
        stage("A"){
            steps{
                echo "========Let Simulate Fail========"
                sh "python3 fail.py"
            }
            post{
                always{
                    steps {
                        sh 'echo "========Execute Simulate Fail on $(date)========"'
                    }
                }
                success{
                    echo "========A executed successfully========"
                }
                failure{
                    echo "========A execution failed========"
                }
            }
        }
    }
}